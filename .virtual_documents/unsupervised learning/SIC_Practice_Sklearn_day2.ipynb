from sklearn.datasets import load_iris


data = load_iris()
data.keys()


print(data.DESCR)


import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt


feature = pd.DataFrame(data=data.data, columns=data.feature_names)
feature


target = pd.DataFrame(data=data.target, columns=['species'])
target


iris = pd.concat([feature, target], axis=1)


iris.columns = ['sepal_length', 'sepal_width', 'petal_length', 'petal_width', 'species']


iris


targets = {}
for idx, x in enumerate(data.target_names):
  targets[idx] = str(x)



targets


iris['species_names'] = iris.species.map(targets)


iris


iris.info()


iris.describe()


iris.corr(numeric_only=True)


iris.groupby('species').size()


def boxplot_iris(feature_names, dataset):
  i = 1
  plt.figure(figsize=(11, 9))
  plt.axis('on')
  plt.subplot(2,2,i)
  plt.tick_params(axis='both', left=True, top=False, right=False, bottom=True,
                  labelleft=False, labeltop=False, labelright=False, labelbottom=False)


from sklearn.datasets import load_breast_cancer


dataset = load_breast_cancer()


dataset.keys()


feature_names = ["_".join(str(x).split(" ")) for x in dataset.feature_names]


feature_df = pd.DataFrame(dataset.data, columns=feature_names)


target_df = pd.DataFrame(dataset.target, columns=['target_values'])


target_df['target_category'] = target_df.target_values.map({x: dataset.target_names[x] for x in range(len(dataset.target_names))})


cancer_df = pd.concat([feature_df, target_df])


cancer_df



