# ---- auto-grader machinery ----
_RESULTS = {}
def test(name, points=1):
    """Decorator: runs the test right away and records pass / fail."""
    def runner(fn):
        try:
            fn(); _RESULTS[name] = (True, points);  print(f"✅ PASS   {name}")
        except AssertionError as e:
            _RESULTS[name] = (False, points); print(f"❌ FAIL   {name}  →  {e}")
        except Exception as e:
            _RESULTS[name] = (False, points); print(f"❌ ERROR  {name}  →  {type(e).__name__}: {e}")
        return fn
    return runner

