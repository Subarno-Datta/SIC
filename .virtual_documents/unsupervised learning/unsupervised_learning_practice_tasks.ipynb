def _check_mcq(qid, ans):
    assert ans is not None, f"set {qid.lower()} to 'A', 'B', 'C' or 'D'"
    ok = hashlib.sha256(f"{qid}:{str(ans).strip().upper()}".encode()).hexdigest() == _MCQ[qid]
    assert ok, "not quite — re-read the options and think about how the algorithm actually works"

# ---- plotting helper (given) ----
def scatter_clusters(P2, labels, title=""):
    P2, labels = np.asarray(P2), np.asarray(labels)
    plt.figure(figsize=(5, 4))
    for lab in np.unique(labels):
        m = labels == lab
        if lab == -1: plt.scatter(P2[m, 0], P2[m, 1], s=14, c="lightgray", label="noise")
        else:         plt.scatter(P2[m, 0], P2[m, 1], s=14, label=f"cluster {lab}")
    plt.title(title); plt.legend(fontsize=7); plt.tight_layout(); plt.show()
