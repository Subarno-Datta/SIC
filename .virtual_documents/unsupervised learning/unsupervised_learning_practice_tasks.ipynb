@test("2.1c  my_kmeans converges with non-increasing inertia", 3)
def _():
    lab, cen, hist = my_kmeans(X, init_c)
    assert lab is not None and cen is not None, "return (labels, centroids, history)"
    assert len(hist) >= 2, "record the inertia at every iteration"
    assert all(b <= a + 1e-9 for a, b in zip(hist, hist[1:])), "inertia must never go up — check the order of your steps"
    assert len(hist) < 100, "it never converged — implement the early stop"
    assert np.asarray(cen).shape == (4, 3), "centroids should be (4, 3)"
    assert (lab == assign_clusters(X, cen)).mean() > 0.99, "labels should be consistent with the final centroids"
    inertia = ((X - cen[lab]) ** 2).sum()
    assert np.isclose(hist[-1], inertia, rtol=1e-3), "history[-1] should be the inertia of the final solution"
    assert np.bincount(lab, minlength=4).min() > 30, "a cluster collapsed"





