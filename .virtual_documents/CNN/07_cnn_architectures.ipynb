    "EfficientNetB0": (apps.EfficientNetB0, apps.efficientnet, 224, 77.1),
    "ResNet50":       (apps.ResNet50, apps.resnet50, 224, 74.9),
    "InceptionV3":    (apps.InceptionV3, apps.inception_v3, 299, 77.9),
    "DenseNet121":    (apps.DenseNet121, apps.densenet, 224, 75.0),
    "ConvNeXtTiny":   (apps.ConvNeXtTiny, apps.convnext, 224, 81.3),
}
answers, speed = {}, {}
for model_name, (build, module, size, _) in MODELS.items():
    model = build(weights="imagenet")
    imgs = photos_at(size)
    for name, img in imgs.items():
        probs = model(module.preprocess_input(img[None].copy()), training=False).numpy()
        answers[(model_name, name)] = [(label, 100 * p) for _, label, p in module.decode_predictions(probs, top=3)[0]]
    batch = module.preprocess_input(imgs["dog"][None].copy())
    for _ in range(3):
        model(batch, training=False)                                # warm up
    start = time.time()
    for _ in range(10):
        model(batch, training=False)
    speed[model_name] = {"ms": 100 * (time.time() - start), "MB": model.count_params() * 4 / 1e6, "weights": model.count_params(), "layers": len(model.layers)}
    print(f"{model_name} done")
    del model

