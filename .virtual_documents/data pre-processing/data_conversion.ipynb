import pandas as pd
import numpy as np


df = pd.read_csv('./auto-mpg.csv')


df


miles_to_km = 1.60934 / 3.78541

df['kpl'] = df['mpg'] * miles_to_km


df


df['kpl'] = df['kpl'].round(2)


df


df.origin.unique()


df['origin'].replace({1: 'USA', 2: 'EU', 3: 'JAPAN'}, inplace=True)


df


df['origin'] = df['origin'].astype('category')


df.dtypes


df['model year'] = df['model year'].astype('category')


df.horsepower.unique()


df.dropna(subset=['horsepower'], axis=0, inplace=True)


df.horsepower.unique()


df['horsepower'] = df['horsepower'].astype('float')


count, bin_dividers = np.histogram(df['horsepower'], bins=3)
print(bin_dividers)


bin_names = ['Low output', 'Normal Output', 'High Output']
df['hp_bin'] = pd.cut(x=df['horsepower'], bins=bin_dividers, labels=bin_names, include_lowest=True)


df[['horsepower', 'hp_bin']]


df


df.head(20)


df['horse_norm'] = df.horsepower/abs(df.horsepower.max())


df






