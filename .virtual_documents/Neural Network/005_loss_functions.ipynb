p = softmax(scores)
one_hot, index = np.array([0, 1, 0]), 1
print("probabilities      :", p)
print(f"categorical CE (one-hot [0,1,0]): -Σ y·log p = {-np.sum(one_hot * np.log(p)):.4f}")
